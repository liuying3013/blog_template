# /etc/nginx/conf.d/10-__SITE_ID__.conf
# 由 infra/bootstrap-site.sh 生成，请勿手工编辑。
#
# 注意：`http2 on;` 需要 Nginx >= 1.25.1。
# 旧版本（如 Ubuntu 22.04 自带的 1.18）请改用 `listen 443 ssl http2;`
# 或从 nginx 官方源安装新版。

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN_APEX__ __DOMAIN_WWW__;

    return 301 https://__DOMAIN_WWW__$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name __DOMAIN_WWW__;

    ssl_certificate
        /etc/ssl/cloudflare/__SITE_ID__-origin.pem;
    ssl_certificate_key
        /etc/ssl/cloudflare/__SITE_ID__-origin-key.pem;

    location = /healthz {
        proxy_pass http://__SITE_ID_UNDERSCORE___active/healthz;
        proxy_http_version 1.1;
        # 清空 Connection 头，upstream keepalive 才会生效
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        add_header Cache-Control
            "no-store"
            always;
    }

    location / {
        proxy_pass http://__SITE_ID_UNDERSCORE___active;
        proxy_http_version 1.1;
        # 清空 Connection 头，upstream keepalive 才会生效
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP
            $remote_addr;
        proxy_set_header X-Forwarded-For
            $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto
            $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # HSTS 统一在 Cloudflare 边缘开启，此处不重复设置，避免配置漂移。
    add_header X-Content-Type-Options
        "nosniff"
        always;
    add_header Referrer-Policy
        "strict-origin-when-cross-origin"
        always;
    add_header Permissions-Policy
        "camera=(), microphone=(), geolocation=()"
        always;
}

# 仅供服务器内部使用的检查端口：部署脚本切换流量后用它验证宿主机 Nginx。
server {
    listen 127.0.0.1:__CHECK_PORT__;
    server_name _;

    location / {
        proxy_pass http://__SITE_ID_UNDERSCORE___active;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}
